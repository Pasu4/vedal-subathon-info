{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Auto-convert timestamps",
            "type": "shell",
            "command": "${workspaceFolder}\\utils\\convert.ps1 -TimestampsFile '${workspaceFolder}\\2026\\timestamps.md' -OverviewFile '${workspaceFolder}\\2026\\overview.md' -Category '${input:category}'",
            "problemMatcher": []
        },
        {
            "label": "Auto-convert timestamps (older VOD)",
            "type": "shell",
            "command": "${workspaceFolder}\\utils\\convert.ps1 -TimestampsFile '${workspaceFolder}\\2026\\timestamps.md' -OverviewFile '${workspaceFolder}\\2026\\overview.md' -Category '${input:category}' -Index ${input:index}",
            "problemMatcher": []
        },
        {
            "label": "Auto-convert timestamps (by URL)",
            "type": "shell",
            "command": "${workspaceFolder}\\utils\\convert.ps1 -TimestampsFile '${workspaceFolder}\\2026\\timestamps.md' -OverviewFile '${workspaceFolder}\\2026\\overview.md' -Category '${input:category}' -VideoUrl ${input:url}",
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "category",
            "type": "pickString",
            "options": [
                "Variety",
                "Just chatting",
                "Karaoke",
                "Dev stream",
                "Vedal gaming",
                "Neuro gaming",
                "Evil gaming",
                "Gaming collab",
                "Watchalong",
                "Marathon",
                "Special event",
                "<other>",
            ],
            "description": "The general type of content in the stream. Choose <other> to add it manually."
        },
        {
            "id": "index",
            "type": "promptString",
            "default": "1",
            "description": "The index of the video. 1 means latest.",
        },
        {
            "id": "url",
            "type": "promptString",
            "description": "The URL of the video.",
        }
    ]
}